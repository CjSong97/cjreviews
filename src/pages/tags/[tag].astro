---
import { getAllTags, getCanonicalTagName, getPostsByTag } from "../../lib/notion/adapter"
import BaseLayout from "../../layouts/BaseLayout.astro"
import RackGrid from "../../components/rack/RackGrid.astro"
import TagKnob from "../../components/controls/TagKnob.astro"

const { tag } = Astro.params

const canonical = tag ? await getCanonicalTagName(tag) : null
if (!canonical) {
  return new Response(null, { status: 404, statusText: "Tag not found" })
}

const [posts, tags] = await Promise.all([getPostsByTag(canonical), getAllTags()])
const count = posts.length
---

<BaseLayout
  title={canonical}
  description={`Every CJ Reviews review tagged ${canonical}.`}
  canonicalUrl={Astro.url.href}
>
  <div class="shell page">
    <header class="head">
      <p class="label">Tag</p>
      <h1 class="title">{canonical}</h1>
      <p class="count">
        <span class="numeral">{count}</span> {count === 1 ? "review" : "reviews"}
      </p>
    </header>

    <div class="controls">
      <TagKnob tags={tags} selected={canonical} />
    </div>

    <RackGrid posts={posts} eagerCount={3} headingLevel={2} />
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: 2.5rem 4rem;
  }

  .head {
    margin-bottom: 1.5rem;
  }

  .controls {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-panel-edge);
  }

  .title {
    font-size: var(--text-h1);
    color: var(--color-text);
    margin-block: 0.25rem;
  }

  .count {
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }
</style>
