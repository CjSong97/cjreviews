---
import { getPostBySlug, getPostBlocks, getRelatedPosts } from "../../lib/notion/adapter"
import BaseLayout from "../../layouts/BaseLayout.astro"
import ReviewHero from "../../components/review/ReviewHero.astro"
import SpecPanel from "../../components/instrument/SpecPanel.astro"
import ArticleBody from "../../components/article/ArticleBody.astro"
import NotionRenderer from "../../components/article/NotionRenderer.astro"
import RelatedPosts from "../../components/rack/RelatedPosts.astro"

const { slug } = Astro.params
const post = slug ? await getPostBySlug(slug) : null

if (!post) {
  return new Response(null, { status: 404, statusText: "Review not found" })
}

const [blocks, related] = await Promise.all([
  getPostBlocks(post.id),
  getRelatedPosts(post, { limit: 4 }),
])

const seoTitle = post.seoTitle ?? post.title
const seoDesc = post.seoDescription ?? post.description ?? ""
---

<BaseLayout
  title={seoTitle}
  description={seoDesc}
  ogImage={post.coverImage ?? undefined}
  canonicalUrl={Astro.url.href}
>
  <div class="shell page">
    <ReviewHero post={post} />

    <article>
      <ArticleBody>
        <NotionRenderer blocks={blocks} />
      </ArticleBody>
    </article>

    <SpecPanel post={post} />

    <RelatedPosts posts={related} />
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: 2rem 4rem;
  }
</style>
