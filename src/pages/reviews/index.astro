---
import { getPublishedPosts } from "../../lib/notion/adapter"
import BaseLayout from "../../layouts/BaseLayout.astro"
import RackGrid from "../../components/rack/RackGrid.astro"

const posts = await getPublishedPosts()
---

<BaseLayout
  title="Reviews"
  description="All earphone, headphone, and game reviews by CJ."
  canonicalUrl={Astro.url.href}
>
  <div class="shell page">
    <header class="head">
      <p class="label">The rack</p>
      <h1 class="title">Reviews</h1>
      <p class="count">
        <span class="numeral">{posts.length}</span> published
      </p>
    </header>

    <RackGrid posts={posts} eagerCount={3} headingLevel={2} />
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: 2.5rem 4rem;
  }

  .head {
    margin-bottom: 2rem;
  }

  .title {
    font-size: var(--text-h1);
    color: var(--color-text);
    margin-block: 0.25rem;
  }

  .count {
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }
</style>
