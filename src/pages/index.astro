---
import { getPublishedPosts } from "../lib/notion/adapter"
import BaseLayout from "../layouts/BaseLayout.astro"
import ResponseHero from "../components/hero/ResponseHero.svelte"
import SignalChain from "../components/hero/SignalChain.svelte"
import RackGrid from "../components/rack/RackGrid.astro"

const posts = await getPublishedPosts()
const featured = posts.filter((p) => p.featured)
const latest = posts.filter((p) => !p.featured)

/*
 * The hero needs several curves to morph between. Featured posts come first;
 * if there aren't enough of them it tops up from the latest, so the signature
 * moment still works on a site with one featured review.
 */
const HERO_COUNT = 3
const showcase = [...featured, ...latest].slice(0, HERO_COUNT)

const heroPosts = showcase.map((p) => ({
  slug: p.slug,
  title: p.title,
  brand: p.brand,
  productName: p.productName,
  rating: p.rating,
  price: p.price,
}))

/*
 * A "signal chain" needs links to chain. Only one post is currently featured, so
 * top up from the latest rather than rendering a chain of one.
 */
const CHAIN_MIN = 6
const chainSource = [...featured, ...latest.filter((p) => !featured.includes(p))].slice(
  0,
  Math.max(CHAIN_MIN, featured.length)
)

const chainPosts = chainSource.map((p) => ({
  slug: p.slug,
  title: p.title,
  brand: p.brand,
  productName: p.productName,
  rating: p.rating,
  productType: p.productType,
}))
---

<BaseLayout
  description="Honest reviews of earphones, headphones, and games by CJ."
  canonicalUrl={Astro.url.href}
>
  {/* client:load because the canvas is the page's opening frame — deferring it
      would show the static trace then swap. */}
  <ResponseHero posts={heroPosts} client:load />

  <SignalChain posts={chainPosts} client:visible />

  <div class="shell page">
    <section class="section" aria-labelledby="latest-heading">
      <h2 id="latest-heading" class="label section-title">Latest reviews</h2>
      <RackGrid posts={latest} />
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: 3rem 4rem;
  }

  .section-title {
    margin-bottom: 1.125rem;
    color: var(--color-signal);
  }
</style>
