---
import type { ReviewPost } from "../../lib/cms/types"
import ProxyImage from "../media/ProxyImage.astro"
import RatingBadge from "../instrument/RatingBadge.astro"
import PriceDisplay from "../instrument/PriceDisplay.astro"

/**
 * A review as a rack unit.
 *
 * Server-rendered with zero client JS: the previous Svelte `client:load` version
 * meant the homepage HTML contained no <img> tags at all, hiding every cover
 * from crawlers (DESIGN.md §9).
 *
 * Games get the phosphor "console mode" accent; the full CRT treatment lands in
 * Phase 3.
 */
interface Props {
  post: ReviewPost
  /** Cards above the fold should not lazy-load. */
  eager?: boolean
  /**
   * Heading level for the card title. Listing pages have no intervening <h2>,
   * so they pass 2 to avoid an h1 -> h3 skip.
   */
  headingLevel?: 2 | 3
}

const { post, eager = false, headingLevel = 3 } = Astro.props

const Heading = `h${headingLevel}` as "h2" | "h3"
const isGame = post.productType === "Game"
const overline = [post.brand, post.productName].filter(Boolean).join(" · ")

// Rendered conditionally rather than hidden with :empty, which never matches
// because Astro leaves whitespace text nodes inside the element.
const hasReadout = post.rating !== null || post.price !== null
---

<article class:list={["card", "bezel", { console: isGame }]}>
  <a href={`/reviews/${post.slug}`} class="hit">
    <div class="frame">
      {
        post.coverImage ? (
          <ProxyImage
            src={post.coverImage}
            alt={`Cover image for ${post.title}`}
            width={640}
            height={360}
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
            eager={eager}
            class="cover"
          />
        ) : (
          <div class="frame-empty" aria-hidden="true">
            <span class="label">no image</span>
          </div>
        )
      }
      <span class="sheen" aria-hidden="true"></span>
      {post.featured && <span class="led" aria-hidden="true"></span>}
    </div>

    <div class="body">
      {overline && <p class="label overline">{overline}</p>}
      <Heading class="title">{post.title}</Heading>
      {post.description && <p class="excerpt">{post.description}</p>}
    </div>
  </a>

  {
    hasReadout && (
      <footer class="readout">
        {post.rating !== null && <RatingBadge rating={post.rating} />}
        {post.price !== null && <PriceDisplay price={post.price} />}
      </footer>
    )
  }
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-panel);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      transform var(--duration-base) var(--ease-instrument),
      box-shadow var(--duration-base) var(--ease-instrument);
  }

  .card:hover,
  .card:focus-within {
    transform: translateY(-2px);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.06),
      inset 0 0 0 1px var(--color-signal-dim),
      0 8px 24px rgb(0 0 0 / 0.28);
  }

  /* The whole card is the hit area, but only one link is in the a11y tree. */
  .hit {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-ground-raised);
  }

  .cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-instrument);
  }

  .card:hover .cover {
    transform: scale(1.03);
  }

  .frame-empty {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
  }

  /* Specular sheen sweep on hover (DESIGN.md §6.3). */
  .sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 35%, rgb(255 255 255 / 0.1) 50%, transparent 65%);
    transform: translateX(-100%);
    transition: transform var(--duration-slow) var(--ease-instrument);
    pointer-events: none;
  }

  .card:hover .sheen {
    transform: translateX(100%);
  }

  .led {
    position: absolute;
    top: 0.625rem;
    right: 0.625rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-signal);
    box-shadow: 0 0 6px var(--color-signal);
  }

  .console .led {
    background: var(--color-phosphor);
    box-shadow: 0 0 6px var(--color-phosphor);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0.875rem 1rem 0.5rem;
  }

  .overline {
    color: var(--color-text-muted);
  }

  .title {
    font-size: var(--text-h3);
    line-height: 1.3;
    color: var(--color-text);
  }

  .card:hover .title {
    color: var(--color-signal);
  }

  .console:hover .title {
    color: var(--color-phosphor);
  }

  .excerpt {
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--color-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .readout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding: 0.625rem 1rem 0.875rem;
    border-top: 1px solid var(--color-panel-edge);
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover {
      transform: none;
    }

    .card:hover .cover {
      transform: none;
    }

    .sheen {
      display: none;
    }
  }
</style>
