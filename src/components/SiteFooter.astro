---
const year = new Date().getFullYear()
---

<footer class="site-footer" transition:persist="site-footer">
  <div class="footer-inner shell">
    <p class="label copyright">
      <span aria-hidden="true">© </span><span class="numeral">{year}</span> CJ Reviews
    </p>
    <nav aria-label="Footer navigation">
      <ul class="footer-links" role="list">
        <li><a href="/reviews" class="label">Reviews</a></li>
        <li><a href="/tags" class="label">Tags</a></li>
        <li><a href="/about" class="label">About</a></li>
        <li><a href="/rss.xml" class="label">RSS</a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--color-panel-edge);
    padding-block: 1.5rem;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .copyright {
    color: var(--color-text-muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    list-style: none;
  }

  .footer-links a {
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-instrument);
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: var(--color-signal);
  }
</style>
