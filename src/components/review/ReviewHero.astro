---
import type { ReviewPost } from "../../lib/cms/types"
import ProxyImage from "../media/ProxyImage.astro"
import RatingBadge from "../instrument/RatingBadge.astro"
import PriceDisplay from "../instrument/PriceDisplay.astro"
import TagPill from "../controls/TagPill.astro"

interface Props {
  post: ReviewPost
}

const { post } = Astro.props

const overline = [post.brand, post.productName].filter(Boolean).join(" · ")
const published = post.publishedAt ? new Date(post.publishedAt) : null
---

<header class="hero">
  {
    post.coverImage && (
      <div class="frame bezel">
        <ProxyImage
          src={post.coverImage}
          alt={`Cover image for ${post.title}`}
          width={1280}
          height={720}
          sizes="(max-width: 1024px) 100vw, 1024px"
          eager={true}
          class="cover"
        />
      </div>
    )
  }

  <div class="meta">
    {overline && <p class="label overline">{overline}</p>}
    <h1 class="title">{post.title}</h1>
    {post.description && <p class="standfirst">{post.description}</p>}

    <div class="readout">
      {post.rating !== null && <RatingBadge rating={post.rating} size="lg" />}
      {post.price !== null && <PriceDisplay price={post.price} size="lg" />}
      {
        published && (
          <time class="date" datetime={published.toISOString()}>
            {published.toLocaleDateString("en-GB", {
              year: "numeric",
              month: "short",
              day: "2-digit",
            })}
          </time>
        )
      }
    </div>

    {
      post.tags.length > 0 && (
        <nav class="tags" aria-label="Tags">
          {post.tags.map((tag) => (
            <TagPill tag={tag} href={`/tags/${encodeURIComponent(tag.toLowerCase())}`} />
          ))}
        </nav>
      )
    }
  </div>
</header>

<style>
  .hero {
    margin-bottom: 2.5rem;
  }

  .frame {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-ground-raised);
    margin-bottom: 1.75rem;
  }

  .cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .meta {
    max-width: var(--max-w-content);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .overline {
    color: var(--color-signal);
  }

  .title {
    font-size: var(--text-h1);
    color: var(--color-text);
  }

  .standfirst {
    font-size: var(--text-article);
    line-height: 1.6;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .readout {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
    padding: 0.875rem 0;
    border-top: 1px solid var(--color-panel-edge);
    border-bottom: 1px solid var(--color-panel-edge);
  }

  .date {
    font-size: var(--text-small);
    color: var(--color-text-muted);
    margin-left: auto;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
</style>
