---
/**
 * The reading surface. Capped at 68ch and deliberately calm — homepage motion
 * never applies here (DESIGN.md §1.3).
 */
---

<div class="article-body">
  <slot />
</div>

<style>
  .article-body {
    max-width: var(--max-w-content);
    margin-inline: auto;
    font-size: var(--text-article);
    line-height: 1.75;
    color: var(--color-text);
    text-wrap: pretty;
  }
</style>
