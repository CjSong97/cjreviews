---
import type { ReviewPost } from "../../lib/cms/types"

/**
 * Console-mode counterpart to the tuning graph.
 *
 * A game has no frequency response, so rather than force an irrelevant curve it
 * gets a verdict bar in the same instrument register — phosphor green, mono
 * numerals, the same panel materials (DESIGN.md §10).
 */
interface Props {
  post: ReviewPost
}

const { post } = Astro.props

const rating = post.rating
const segments = 20
const lit = rating === null ? 0 : Math.ceil((Math.max(0, Math.min(100, rating)) / 100) * segments)
---

{
  rating !== null && (
    <aside class="verdict bezel" aria-labelledby="verdict-heading">
      <h2 id="verdict-heading" class="label heading">
        Verdict
      </h2>

      <div class="meter">
        <span class="numeral score">{rating}</span>
        <span class="of">/100</span>
        <span class="bar" aria-hidden="true">
          {Array.from({ length: segments }, (_, i) => (
            <span class:list={["seg", { on: i < lit }]} />
          ))}
        </span>
      </div>

      {post.tuningNote && <p class="note">{post.tuningNote}</p>}
    </aside>
  )
}

<style>
  .verdict {
    position: relative;
    max-width: var(--max-w-content);
    margin: 2rem auto 0;
    padding: 1.125rem 1.25rem;
    border-radius: var(--radius);
    background: var(--color-panel);
    overflow: hidden;
  }

  /* CRT scanlines — the console-mode signature. Suppressed under reduced
     motion below, since a fine repeating pattern is itself uncomfortable. */
  .verdict::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      rgb(61 220 145 / 0.05) 0 1px,
      transparent 1px 3px
    );
  }

  .heading {
    color: var(--color-phosphor);
    margin-bottom: 0.75rem;
  }

  .meter {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
  }

  .score {
    font-size: 2rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1;
  }

  .of {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-right: 0.625rem;
  }

  .bar {
    display: flex;
    gap: 2px;
    align-items: flex-end;
  }

  .seg {
    width: 5px;
    height: 18px;
    border-radius: 1px;
    background: var(--color-panel-edge);
  }

  .seg.on {
    background: var(--color-phosphor);
    box-shadow: 0 0 4px rgb(61 220 145 / 0.5);
  }

  .note {
    margin-top: 0.75rem;
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .verdict::after {
      display: none;
    }
  }
</style>
